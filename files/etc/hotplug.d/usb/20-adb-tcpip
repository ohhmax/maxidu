#!/bin/sh
# Auto restart ADB daemon in TCP mode on port 5555 when USB phone is connected
[ "$ACTION" = "bind" ] || [ "$ACTION" = "add" ] || exit 0

(
    sleep 3
    if which adb >/dev/null 2>&1; then
        export ADB_MDNS_OPENSCREEN=0
        /usr/bin/adb devices >/dev/null 2>&1
        /usr/bin/adb tcpip 5555 >/dev/null 2>&1
    fi
) &
exit 0
