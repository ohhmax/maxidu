      }
    },
    "lan3": {
      "portIndex": 3,
      "mode": "layer2_ap",
      "ap": {
        "ip": "10.0.0.166",
        "mac": "a8:1b:5a:c3:01:13",
        "name": "Asus Router / AP",
        "model": "Asus RT-AX53U AP"
      },
      "layer3_devices": [
        {
          "ip": "10.0.0.5",
          "mac": "00:11:32:92:02:1b",
          "name": "Synology NAS [STORAGE]",
          "conn_type": "LAN Port"
        },
        {
