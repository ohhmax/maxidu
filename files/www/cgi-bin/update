#!/bin/sh
echo "Content-Type: application/json"
echo "Cache-Control: no-cache, no-store, must-revalidate"
echo "Access-Control-Allow-Origin: *"
echo ""

ACTION="$1"
[ -z "$ACTION" ] && ACTION=$(echo "$QUERY_STRING" | sed -n 's/^.*action=\([^&]*\).*$/\1/p')

CURRENT_BUILD=$(grep -o '#[0-9]*' /etc/banner | tr -d '#' | head -n 1)
CURRENT_VER=$(grep -o 'v2\.[0-9.]*' /etc/banner | head -n 1)
[ -z "$CURRENT_BUILD" ] && CURRENT_BUILD=20
[ -z "$CURRENT_VER" ] && CURRENT_VER="v2.2.20"

if [ "$ACTION" = "flash" ] || [ "$ACTION" = "flash_clean" ]; then
    LATEST_TAG=$(curl -s -H 'User-Agent: MaxNet' --connect-timeout 6 https://api.github.com/repos/ohhmax/maxidu/releases | grep -o 'v2\.2-minimal-usb3-b[0-9]*' | sort -V | tail -n 1)
    if [ -z "$LATEST_TAG" ]; then
        echo '{"status": "error", "message": "Failed to resolve latest release from GitHub"}'
        exit 0
    fi

    BIN_URL="https://github.com/ohhmax/maxidu/releases/download/${LATEST_TAG}/sysupgrade.bin"
    SUM_URL="https://github.com/ohhmax/maxidu/releases/download/${LATEST_TAG}/sha256sums"

    cd /tmp
    rm -f sysupgrade-new.bin sha256sums-new
    curl -s -L --connect-timeout 10 --max-time 180 -o sysupgrade-new.bin "$BIN_URL"
    curl -s -L --connect-timeout 10 --max-time 30 -o sha256sums-new "$SUM_URL"

    EXPECTED_SUM=$(grep 'sysupgrade.bin' sha256sums-new 2>/dev/null | awk '{print $1}')
    ACTUAL_SUM=$(sha256sum sysupgrade-new.bin 2>/dev/null | awk '{print $1}')

    if [ -n "$EXPECTED_SUM" ] && [ "$EXPECTED_SUM" = "$ACTUAL_SUM" ]; then
        mv sysupgrade-new.bin /tmp/sysupgrade.bin
        if [ "$ACTION" = "flash_clean" ]; then
            echo "{\"status\": \"flashing\", \"mode\": \"clean\", \"tag\": \"$LATEST_TAG\", \"message\": \"Firmware verified. Starting clean flash (erasing all config) & rebooting...\"}"
            ( sleep 2 && sysupgrade -n -F -v /tmp/sysupgrade.bin ) >/dev/null 2>&1 &
        else
            echo "{\"status\": \"flashing\", \"mode\": \"keep_config\", \"tag\": \"$LATEST_TAG\", \"message\": \"Firmware verified. Starting flash (preserving config) & rebooting...\"}"
            ( sleep 2 && sysupgrade -F -v /tmp/sysupgrade.bin ) >/dev/null 2>&1 &
        fi
        exit 0
    else
        echo "{\"status\": \"error\", \"message\": \"SHA256 mismatch (expected $EXPECTED_SUM, got $ACTUAL_SUM)\"}"
        exit 0
    fi
fi

# Default: Check update
LATEST_TAG=$(curl -s -H 'User-Agent: MaxNet' --connect-timeout 5 https://api.github.com/repos/ohhmax/maxidu/releases | grep -o 'v2\.2-minimal-usb3-b[0-9]*' | sort -V | tail -n 1)
LATEST_BUILD=$(echo "$LATEST_TAG" | sed 's/.*-b//')

if [ -z "$LATEST_BUILD" ]; then
    echo "{\"status\": \"error\", \"current\": \"$CURRENT_VER\", \"message\": \"Could not reach GitHub Releases\"}"
    exit 0
fi

if [ "$LATEST_BUILD" -gt "$CURRENT_BUILD" ]; then
    echo "{\"status\": \"update_available\", \"current\": \"$CURRENT_VER\", \"latest\": \"$LATEST_TAG\", \"latest_build\": $LATEST_BUILD, \"current_build\": $CURRENT_BUILD}"
else
    echo "{\"status\": \"up_to_date\", \"current\": \"$CURRENT_VER\", \"latest\": \"$LATEST_TAG\", \"current_build\": $CURRENT_BUILD}"
fi
